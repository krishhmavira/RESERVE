rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.userId == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
    }

    // Donations collection
    // - Any authenticated user can read (NGOs browse available donations)
    // - Only the donor can create (donorId must match auth uid)
    // - The donor can update any field on their own donation
    // - A non-donor can only change the status field, and only for:
    //     AVAILABLE -> REQUESTED (NGO creates a food request)
    //     REQUESTED -> AVAILABLE (NGO cancels their request)
    match /donations/{donationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.donorId == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.donorId == request.auth.uid
                        || (onlyStatusChanged()
                            && ((resource.data.status == 'AVAILABLE'
                                 && request.resource.data.status == 'REQUESTED')
                                || (resource.data.status == 'REQUESTED'
                                    && request.resource.data.status == 'AVAILABLE'))));
    }

    // Food requests collection
    // - Single-document reads require the user to be the ngoId or donorId
    // - Query/list operations allowed for any authenticated user
    // - Only NGOs can create requests (ngoId must match auth uid)
    // - Only involved parties can update (ngoId or donorId must match)
    match /foodRequests/{requestId} {
      allow get: if request.auth != null
                 && (resource.data.ngoId == request.auth.uid
                     || resource.data.donorId == request.auth.uid);
      allow list: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ngoId == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.ngoId == request.auth.uid
                        || resource.data.donorId == request.auth.uid);
    }

    function onlyStatusChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }
  }
}
