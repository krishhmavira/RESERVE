rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection
    // - Any authenticated user can read their own profile
    // - Any authenticated user can create their own profile (on registration)
    // - Users can only update their own profile
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.userId == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
    }

    // Donations collection
    // - Authenticated users can read any donation (NGOs browse available donations)
    // - Only the donor (donorId) can create their own donations
    // - The donor can update their own donation status
    // - NGO request flows also update donation status via batch writes,
    //   so we allow update if the user is the donor OR if only the status field changes
    //   and the user is authenticated (covers approve/reject batch from NGO-side request operations)
    match /donations/{donationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.donorId == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.donorId == request.auth.uid
                        || onlyStatusChanged());
    }

    // Food requests collection
    // - Authenticated users can read requests they are involved in
    //   (as ngoId or donorId)
    // - NGOs can create requests with their own ngoId
    // - The NGO who created the request can update it (cancel)
    // - The donor of the related donation can also update the request (approve/reject)
    // - Batch writes from approve/reject update status, so we allow if authenticated
    //   and only the status field changes
    match /foodRequests/{requestId} {
      allow read: if request.auth != null
                  && (resource.data.ngoId == request.auth.uid
                      || resource.data.donorId == request.auth.uid);
      allow list: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ngoId == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.ngoId == request.auth.uid
                        || resource.data.donorId == request.auth.uid
                        || onlyStatusChanged());
    }

    // Helper: returns true when only the 'status' field is being modified
    function onlyStatusChanged() {
      return request.auth != null
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }
  }
}
